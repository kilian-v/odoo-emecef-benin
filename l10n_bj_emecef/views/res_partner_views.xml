<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_emecef_ifu" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.emecef.ifu</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='vat']" position="after">
                <button name="action_fetch_ifu_data"
                        type="object"
                        string="Récupérer infos DGI"
                        class="oe_link"
                        icon="fa-cloud-download"
                        invisible="not vat"/>
            </xpath>

        </field>
    </record>
</odoo>