<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_emecef" model="ir.ui.view">
        <field name="name">res.company.form.inherit.emecef</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Configuration e-MECeF">
                    <group>
                        <group>
                            <field name="emecef_env"/>
                            <field name="emecef_ifu"/>
                            <field name="emecef_nim"/>
                        </group>
                        <group>
                            <field name="emecef_token" password="True"/>

                            <button name="action_check_emecef_connection"
                                    string="Tester la connexion API"
                                    type="object"
                                    class="btn-primary mt-3"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>